{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "midgar-catalog",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 */6 * * *"] },
  "kv_namespaces": [
    { "binding": "MIDGAR", "id": "21fa1edee455481d8edc6d98de362cf3" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "midgar-events",
      "database_id": "05d39b0c-333c-4c8c-a603-e8b9aa6ebd8d",
      "migrations_dir": "migrations"
    }
  ]
}
