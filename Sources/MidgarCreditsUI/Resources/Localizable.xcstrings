          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입을 확인하지 못했습니다. 요금이 청구되었다면 지원팀에 문의해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
