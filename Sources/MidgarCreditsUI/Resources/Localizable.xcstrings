            "state": "translated",
            "value": "Je bent offline. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к сети. Проверьте подключение и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är offline. Kontrollera anslutningen och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออฟไลน์อยู่ กรุณาตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısınız. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến. Hãy kiểm tra kết nối và thử lại."
          }
        }
      }
    },
