    "Your credits arrive as soon as it is confirmed. You do not need to buy again.": {
      "comment": "Detail of the row shown after a credit pack was paid for but its credits have not arrived yet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your credits arrive as soon as it is confirmed. You do not need to buy again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Credits kommen an, sobald der Kauf bestätigt ist. Du musst nicht erneut kaufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus créditos llegarán en cuanto se confirme. No necesitas volver a comprar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos crédits arriveront dès la confirmation. Vous n'avez pas besoin de racheter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi crediti arriveranno non appena sarà confermato. Non devi acquistare di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認でき次第、クレジットが反映されます。もう一度購入する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인되는 즉시 크레딧이 지급됩니다. 다시 구입할 필요가 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredyty pojawią się zaraz po potwierdzeniu. Nie musisz kupować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus créditos chegam assim que for confirmada. Você não precisa comprar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认后积分将立即到账。你无需再次购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認後點數會立即入帳。你不需要再次購買。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستصل حزمة رصيدك فور تأكيدها. لا حاجة إلى الشراء مرة أخرى."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πιστώσεις σας θα προστεθούν μόλις επιβεβαιωθεί η αγορά. Δεν χρειάζεται να αγοράσετε ξανά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediitit saapuvat heti, kun osto on vahvistettu. Sinun ei tarvitse ostaa uudelleen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקרדיטים שלך יגיעו ברגע שהרכישה תאושר. אין צורך לרכוש שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि होते ही आपके क्रेडिट मिल जाएँगे। आपको दोबारा खरीदने की ज़रूरत नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit Anda akan masuk begitu dikonfirmasi. Anda tidak perlu membeli lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je credits komen binnen zodra de aankoop is bevestigd. Je hoeft niet opnieuw te kopen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиты поступят сразу после подтверждения покупки. Покупать повторно не нужно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina krediter kommer så snart köpet har bekräftats. Du behöver inte köpa igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครดิตของคุณจะเข้าบัญชีทันทีที่ยืนยันแล้ว ไม่ต้องซื้อซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylandığı anda krediler hesabınıza yüklenir. Tekrar satın almanız gerekmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tín dụng sẽ được cộng ngay khi giao dịch được xác nhận. Bạn không cần mua lại."
          }
        }
      }
    },
