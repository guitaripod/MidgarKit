    "The App Store did not return any credit packs. Check your connection and try again.": {
      "comment": "Detail shown in the credit store when the App Store returned no credit packs",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store did not return any credit packs. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store hat keine Credit-Pakete zurückgegeben. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La App Store no devolvió ningún paquete de créditos. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store n'a renvoyé aucun pack de crédits. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store non ha restituito alcun pacchetto di crediti. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeからクレジットパックを取得できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 크레딧 팩을 가져오지 못했습니다. 연결 상태를 확인하고 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nie zwrócił żadnych pakietów kredytów. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não retornou nenhum pacote de créditos. Verifique sua conexão e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 未返回任何积分包。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 未傳回任何點數包。請檢查網路連線後再試一次。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُرجع App Store أي حزم رصيد. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το App Store δεν επέστρεψε πακέτα πιστώσεων. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ei palauttanut krediittipaketteja. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-App Store לא החזיר חבילות קרדיטים. בדוק את החיבור ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store से कोई क्रेडिट पैक नहीं मिला। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store tidak mengembalikan paket kredit apa pun. Periksa koneksi Anda dan coba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store heeft geen creditpakketten teruggegeven. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store не вернул ни одного пакета кредитов. Проверьте подключение и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store returnerade inga kreditpaket. Kontrollera anslutningen och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ไม่ส่งแพ็กเกจเครดิตกลับมา กรุณาตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store hiçbir kredi paketi döndürmedi. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store không trả về gói tín dụng nào. Hãy kiểm tra kết nối và thử lại."
          }
        }
      }
    },
    "The purchase could not be verified. If you were charged, contact support.": {
      "comment": "Message when the credit service refused to credit a pack the person paid for",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase could not be verified. If you were charged, contact support."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht überprüft werden. Falls dir etwas berechnet wurde, wende dich an den Support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la compra. Si se te cobró, contacta con soporte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat n'a pas pu être vérifié. Si vous avez été débité, contactez l'assistance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare l'acquisto. Se ti è stato addebitato, contatta l'assistenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を確認できませんでした。請求された場合は、サポートまでご連絡ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입을 확인하지 못했습니다. 요금이 청구되었다면 지원팀에 문의해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zweryfikować zakupu. Jeśli pobrano opłatę, skontaktuj się z pomocą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a compra. Se você foi cobrado, entre em contato com o suporte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证此购买。如果已扣费，请联系支持团队。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證此購買。如果已扣款，請聯絡支援團隊。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من عملية الشراء. إذا تم خصم مبلغ منك، فتواصل مع الدعم."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η επαλήθευση της αγοράς. Αν χρεωθήκατε, επικοινωνήστε με την υποστήριξη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoa ei voitu vahvistaa. Jos sinulta veloitettiin summa, ota yhteyttä tukeen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאמת את הרכישה. אם חויבת, פנה לתמיכה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदारी की पुष्टि नहीं हो सकी। अगर आपसे शुल्क लिया गया है, तो सहायता से संपर्क करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian tidak dapat diverifikasi. Jika Anda ditagih, hubungi dukungan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop kon niet worden geverifieerd. Als je bent afgeschreven, neem dan contact op met support."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить покупку. Если с вас списали деньги, обратитесь в поддержку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet kunde inte verifieras. Om du blev debiterad, kontakta supporten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถยืนยันการซื้อได้ หากมีการเรียกเก็บเงิน กรุณาติดต่อฝ่ายสนับสนุน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma doğrulanamadı. Ücret alındıysa destekle iletişime geçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh giao dịch mua. Nếu bạn đã bị trừ tiền, hãy liên hệ bộ phận hỗ trợ."
          }
        }
      }
    },
    "Too many requests. Try again in a moment.": {
      "comment": "Message when the credit service asks the app to slow down",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Try again in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anfragen. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas solicitudes. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de requêtes. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe richieste. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 너무 많습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele żądań. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas solicitações. Tente novamente em instantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过多。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求過多。請稍後再試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات كثيرة جدًا. حاول مرة أخرى بعد قليل."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρα πολλά αιτήματα. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian monta pyyntöä. Yritä hetken päästä uudelleen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יותר מדי בקשות. נסה שוב בעוד רגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत अधिक अनुरोध। कुछ देर बाद फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak permintaan. Coba lagi sebentar lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel verzoeken. Probeer het zo meer opnieuw."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов. Повторите попытку через минуту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många förfrågningar. Försök igen om en stund."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคำขอมากเกินไป กรุณาลองอีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla istek. Lütfen biraz sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá nhiều yêu cầu. Vui lòng thử lại sau ít phút."
          }
        }
      }
    },
    "Waiting for approval. Your credits arrive as soon as it is approved.": {
      "comment": "Message after a credit pack purchase needs approval, for example Ask to Buy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval. Your credits arrive as soon as it is approved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Genehmigung. Deine Credits kommen an, sobald sie erteilt wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. Tus créditos llegarán en cuanto se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d'approbation. Vos crédits arriveront dès qu'elle sera approuvée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di approvazione. I tuoi crediti arriveranno non appena verrà approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ちです。承認されるとすぐにクレジットが反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 대기 중입니다. 승인되는 즉시 크레딧이 지급됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na zatwierdzenie. Kredyty pojawią się zaraz po zatwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação. Seus créditos chegam assim que for aprovada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待批准。获批后积分将立即到账。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待核准。核准後點數會立即入帳。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار الموافقة. سيُضاف رصيدك فور الموافقة عليه."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναμονή έγκρισης. Οι πιστώσεις σας θα προστεθούν μόλις εγκριθεί η αγορά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odottaa hyväksyntää. Krediitit saapuvat heti, kun osto on hyväksytty."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתין לאישור. הקרדיטים שלך יגיעו ברגע שהרכישה תאושר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मंज़ूरी का इंतज़ार है। मंज़ूरी मिलते ही आपके क्रेडिट मिल जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu persetujuan. Kredit Anda akan masuk begitu disetujui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht op goedkeuring. Je credits komen binnen zodra het is goedgekeurd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание подтверждения. Кредиты поступят сразу после одобрения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på godkännande. Dina krediter kommer så snart köpet godkänts."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอการอนุมัติ เครดิตของคุณจะเข้าบัญชีทันทีที่ได้รับการอนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay bekleniyor. Onaylanır onaylanmaz kredileriniz hesabınıza yüklenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ phê duyệt. Tín dụng sẽ được cộng ngay khi được phê duyệt."
          }
        }
      }
    },
    "You are offline. Check your connection and try again.": {
      "comment": "Message when a credit purchase could not reach the server because the device is offline",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are offline. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors connexion. Vérifiez votre connexion et réessayez."
