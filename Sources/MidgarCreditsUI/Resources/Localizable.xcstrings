        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a compra. Se você foi cobrado, entre em contato com o suporte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
