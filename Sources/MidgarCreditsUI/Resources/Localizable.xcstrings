          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل بالإنترنت. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε εκτός σύνδεσης. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet offline-tilassa. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חיבור לאינטרנט. בדוק את החיבור ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang offline. Periksa koneksi Anda dan coba lagi."
          }
        },
        "nl": {
