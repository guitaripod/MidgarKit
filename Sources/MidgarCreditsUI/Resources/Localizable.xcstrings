    "Your session has expired. Sign in and try again.": {
      "comment": "Message when a credit purchase was refused because the person is not signed in",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Sign in and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist abgelaufen. Melde dich an und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión ha caducado. Inicia sesión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session a expiré. Connectez-vous et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua sessione è scaduta. Accedi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの有効期限が切れました。サインインして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 만료되었습니다. 로그인한 후 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja sesja wygasła. Zaloguj się i spróbuj ponownie."
