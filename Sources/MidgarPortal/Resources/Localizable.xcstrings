    "Every app we make lives here. Drag to explore, tap an icon to look closer.": {
      "comment": "Portal card text while the Midgar emblem at the centre is selected",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every app we make lives here. Drag to explore, tap an icon to look closer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تطبيق نصنعه موجود هنا. اسحب للاستكشاف، واضغط على أيقونة للاقتراب أكثر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny naše aplikace najdete tady. Tažením prozkoumejte, klepnutím na ikonu si ji prohlédněte blíže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vores apps findes her. Træk for at udforske, tryk på et ikon for at se nærmere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier finden Sie alle unsere Apps. Ziehen zum Erkunden, tippen auf ein Symbol für eine genauere Ansicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí está cada app que creamos. Arrastra para explorar y toca un icono para verlo de cerca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tekemämme sovellukset ovat täällä. Vedä tutkiaksesi, napauta kuvaketta tarkastellaksesi sitä lähemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes nos applications sont ici. Faites glisser pour explorer, touchez une icône pour la voir de plus près."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui trovi tutte le app che creiamo. Trascina per esplorare, tocca un'icona per vederla da vicino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私たちのアプリはすべてここにあります。ドラッグして探索し、アイコンをタップして詳しく見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저희가 만든 모든 앱이 여기 있습니다. 드래그하여 둘러보고, 아이콘을 탭하면 자세히 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle appene vi lager, finnes her. Dra for å utforske, trykk på et ikon for å se nærmere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke app die we maken staat hier. Sleep om te verkennen, tik op een icoon om het beter te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie nasze aplikacje znajdziesz tutaj. Przeciągaj, by odkrywać, a stuknięciem w ikonę zobaczysz ją z bliska."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os apps que criamos estão aqui. Arraste para explorar e toque em um ícone para ver de perto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as apps que criamos estão aqui. Arraste para explorar e toque num ícone para ver mais de perto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все наши приложения собраны здесь. Перетаскивайте, чтобы исследовать, и нажимайте на значок, чтобы рассмотреть его ближе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla appar vi gör finns här. Dra för att utforska och tryck på en ikon för att titta närmare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaptığımız her uygulama burada. Keşfetmek için sürükleyin, yakından bakmak için bir simgeye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі наші застосунки зібрано тут. Перетягуйте, щоб дослідити, і торкніться значка, щоб розглянути ближче."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi ứng dụng chúng tôi làm đều có ở đây. Kéo để khám phá, chạm vào biểu tượng để xem kỹ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们开发的每款应用都在这里。拖动即可探索，点按图标可仔细查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們開發的每款 App 都在這裡。拖曳即可探索，點按圖示可仔細查看。"
          }
        }
      }
    },
