    "Counts are turned off, so none of these are sent.": {
      "comment": "Footer under that list while the switch is off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العدادات متوقفة، لذا لن يُرسل أي من هذه العدادات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počty jsou vypnuté, takže se žádný z těchto údajů neodesílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal er slået fra, så ingen af disse sendes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählwerte sind ausgeschaltet, daher wird nichts davon gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts are turned off, so none of these are sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recuentos están desactivados, así que no se envía ninguno de estos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttömäärät ovat pois käytöstä, joten mitään näistä ei lähetetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les compteurs sont désactivés, donc aucun de ces éléments n'est envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I conteggi sono disattivati, quindi nessuno di questi viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用回数の送信はオフになっているため、以下はいずれも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 횟수가 꺼져 있으므로 아래 항목은 어느 것도 보내지지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tellingen er slått av, så ingen av disse blir sendt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tellingen staan uit, dus geen van deze wordt verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczniki są wyłączone, więc żadne z tych danych nie są wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As contagens estão desativadas, então nada disso é enviado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As contagens estão desativadas, por isso nada disto é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика отключена, поэтому ничего из этого не отправляется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiken är avstängd, så inget av detta skickas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayılar kapalı olduğundan bunlardan hiçbiri gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічильники вимкнено, тому жодні з них не надсилаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lần sử dụng đang tắt, nên không có mục nào trong số này được gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用次数已关闭，因此以下内容均不会发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用次數已關閉，因此以下內容均不會傳送。"
          }
        }
      }
    },
    "Counts of crashes, freezes and heavy disk or processor use, so they get fixed.": {
      "comment": "Purpose of an anonymous count.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدادات الأعطال والتجمد واستخدام القرص أو المعالج بكثافة، لإصلاحها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počty pádů, zamrznutí a náročného využití disku nebo procesoru, aby se mohly opravit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal for nedbrud, frysninger og tung brug af disk eller processor, så de bliver rettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählwerte für Abstürze, Hänger und starke Nutzung von Speicher oder Prozessor, damit sie behoben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts of crashes, freezes and heavy disk or processor use, so they get fixed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuentos de fallos, bloqueos y uso intensivo del disco o del procesador, para corregirlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaatumisten, jäätymisten ja raskaan levy- tai prosessorikäytön määrät, jotta ne saadaan korjattua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compteurs de plantages, de blocages et d'utilisation intensive du disque ou du processeur, pour corriger ces problèmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteggi di arresti anomali, blocchi e uso intensivo di disco o processore, così vengono corretti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラッシュ、フリーズ、ディスクやプロセッサの高負荷の回数。修正に使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충돌, 멈춤, 디스크 또는 프로세서의 과도한 사용 횟수. 문제를 고치는 데 사용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tall på krasj, fryser og tung bruk av disk eller prosessor, slik at dette blir rettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tellingen van crashes, vastlopers en zware schijf- of processorbelasting, zodat die worden verholpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba awarii, zawieszeń oraz dużego obciążenia dysku lub procesora, aby można je było naprawić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagens de travamentos, congelamentos e uso intenso de disco ou processador, para que sejam corrigidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagens de falhas, bloqueios e utilização intensa do disco ou do processador, para que sejam corrigidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Количество сбоев, зависаний и высокой нагрузки на диск или процессор, чтобы их исправляли."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Antal krascher, frysningar och hög belastning på disk eller processor, så att de kan åtgärdas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çökmelerin, donmaların ve yoğun disk veya işlemci kullanımının sayıları, düzeltilebilmeleri için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лічильники збоїв, зависань і надмірного навантаження на диск або процесор, щоб їх можна було виправити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lần ứng dụng bị lỗi, treo và sử dụng nhiều ổ đĩa hoặc bộ xử lý, để có thể khắc phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计崩溃、卡死以及磁盘或处理器的高负载情况，以便修复问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "統計當機、凍結以及磁碟或處理器的高負載情況，以便修正問題。"
          }
        }
      }
    },
    "Counts only, never anything that identifies you.": {
      "comment": "Footer under the usage counts switch in settings",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعداد فقط، ولا شيء يحدد هويتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze počty, nikdy nic, co by vás identifikovalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tal, aldrig noget der identificerer dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Zählwerte, nie etwas, das dich identifiziert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts only, never anything that identifies you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo recuentos, nunca nada que te identifique."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain lukumääriä, ei koskaan mitään, mistä sinut tunnistaisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement des compteurs, jamais rien qui vous identifie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo conteggi, mai nulla che ti identifichi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信されるのは回数だけで、あなたを特定できる情報は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "횟수만 전송되며, 사용자를 식별할 수 있는 정보는 전혀 포함되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare antall, aldri noe som identifiserer deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen tellingen, nooit iets wat jou identificeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko liczby, nigdy nic, co pozwala Cię zidentyfikować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas contagens, nunca nada que identifique você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas contagens, nunca nada que o identifique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только счётчики, ничего, что позволяло бы вас опознать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara antal, aldrig något som identifierar dig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca sayılar, sizi tanımlayan hiçbir şey asla gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише лічильники, ніколи нічого, що ідентифікує вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ là số liệu, không bao giờ có thông tin nhận dạng bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅发送次数,绝不包含任何可识别你身份的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅傳送次數,絕不包含任何可識別你身分的資訊。"
          }
        }
      }
    },
    "Daily numbers on how fast the app starts and how much memory it uses, so slow versions get fixed.": {
      "comment": "Purpose of an anonymous count.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرقام يومية عن سرعة بدء التطبيق وحجم الذاكرة التي يستهلكها، لإصلاح الإصدارات البطيئة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Denní čísla o tom, jak rychle se aplikace spouští a kolik paměti využívá, aby se opravily pomalé verze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Daglige tal for, hvor hurtigt appen starter, og hvor meget hukommelse den bruger, så langsomme versioner bliver rettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Zahlen dazu, wie schnell die App startet und wie viel Speicher sie nutzt, damit langsame Versionen verbessert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily numbers on how fast the app starts and how much memory it uses, so slow versions get fixed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifras diarias sobre la rapidez con la que se inicia la app y la memoria que usa, para corregir las versiones lentas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivittäiset luvut siitä, kuinka nopeasti sovellus käynnistyy ja kuinka paljon muistia se käyttää, jotta hitaat versiot saadaan korjattua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffres quotidiens sur la rapidité de démarrage de l'app et la mémoire utilisée, pour corriger les versions lentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati giornalieri sulla velocità di avvio dell'app e sulla memoria che usa, così le versioni lente vengono corrette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの起動速度と使用メモリの日次データ。遅いバージョンを改善するために使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 실행 속도와 메모리 사용량에 대한 일간 수치. 느린 버전을 개선하는 데 사용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Daglige tall for hvor raskt appen starter og hvor mye minne den bruker, slik at trege versjoner blir rettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagelijkse cijfers over hoe snel de app start en hoeveel geheugen hij gebruikt, zodat trage versies worden verbeterd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzienne dane o tym, jak szybko aplikacja się uruchamia i ile pamięci zużywa, aby wolne wersje można było poprawić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Números diários sobre a velocidade de abertura do app e o uso de memória, para que versões lentas sejam corrigidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Números diários sobre a rapidez de arranque da aplicação e a memória que utiliza, para que as versões lentas sejam corrigidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневные показатели скорости запуска приложения и расхода памяти, чтобы медленные версии исправляли."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagliga siffror över hur snabbt appen startar och hur mycket minne den använder, så att långsamma versioner kan åtgärdas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın ne kadar hızlı açıldığına ve ne kadar bellek kullandığına dair günlük sayılar, yavaş sürümlerin düzeltilmesi için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоденні дані про швидкість запуску застосунку та обсяг використаної пам'яті, щоб повільні версії виправляли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số liệu hằng ngày về tốc độ khởi động và lượng bộ nhớ ứng dụng sử dụng, để các phiên bản chậm được khắc phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日统计应用的启动速度和内存占用，以便修复运行缓慢的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每日統計 App 的啟動速度和記憶體用量，以便修正運行緩慢的版本。"
          }
        }
      }
    },
