        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro app da Midgar foi aberto a partir dessa tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra aplicação Midgar foi aberta a partir desse ecrã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этого экрана открыли другое приложение Midgar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan Midgar-app öppnades från skärmen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekrandan başka bir Midgar uygulaması açıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З цього екрана відкрито інший застосунок Midgar."
