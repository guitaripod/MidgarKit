    "Finished week starting %@. These count installs, not people.": {
      "comment": "Footer under the public figures. %@ is a date such as 'Oct 19'. Keep %@ exactly.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسبوع المنتهي بدءًا من %@. تحسب هذه الأرقام عمليات التثبيت، لا الأشخاص."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončený týden od %@. Počítají se instalace, ne osoby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afsluttet uge fra %@. Disse tal tæller installationer, ikke personer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Woche ab %@. Hier werden Installationen gezählt, nicht Personen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished week starting %@. These count installs, not people."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Semana finalizada desde el %@. Estos recuentos cuentan instalaciones, no personas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päättynyt viikko alkaen %@. Nämä lasketaan asennuksina, eivät ihmisinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Semaine terminée à partir du %@. Ces chiffres comptent des installations, pas des personnes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Settimana conclusa iniziata il %@. Questi dati contano installazioni, non persone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から始まる週の集計が完了しました。これは人数ではなくインストール数です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@부터 시작한 주의 집계가 완료되었습니다. 이 수치는 사람이 아니라 설치 수를 센 것입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsluttet uke som startet %@. Disse tallene teller installasjoner, ikke personer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgeronde week die begint op %@. Deze cijfers tellen installaties, geen personen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończony tydzień od %@. Liczby dotyczą instalacji, a nie osób."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Semana encerrada a partir de %@. Estas contagens se referem a instalações, não a pessoas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Semana terminada a partir de %@. Estas contagens referem-se a instalações, não a pessoas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершённая неделя, начавшаяся %@. Эти числа относятся к установкам, а не к людям."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutad vecka som började %@. Siffrorna avser installationer, inte personer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihinde başlayan hafta tamamlandı. Bu sayılar kişileri değil, yüklemeleri gösterir."
          }
        },
        "uk": {
