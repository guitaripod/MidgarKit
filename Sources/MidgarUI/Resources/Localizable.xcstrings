    "Another Midgar app was opened from that screen.": {
      "comment": "Purpose of an anonymous count. Midgar is a company name, do not translate it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فتح تطبيق Midgar آخر من تلك الشاشة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z této obrazovky se otevřela další aplikace Midgar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden Midgar-app blev åbnet fra skærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Midgar-App wurde von diesem Bildschirm aus geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another Midgar app was opened from that screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abrió otra app de Midgar desde esa pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen Midgar-sovellus avattiin tästä näkymästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app Midgar a été ouverte depuis cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra app Midgar è stata aperta da quella schermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その画面から別のMidgarアプリが開かれました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 화면에서 다른 Midgar 앱을 열었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen Midgar-app ble åpnet fra skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er werd vanaf dat scherm een andere Midgar-app geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z tego ekranu otwarto inną aplikację Midgar."
