    "This permanently deletes your account and its data. This cannot be undone.": {
      "comment": "Message of the confirmation before deleting the account",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف حسابك وبياناته نهائيًا. لا يمكن التراجع عن ذلك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto trvale smažete svůj účet a jeho data. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter din konto og dens data permanent. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden dein Konto und alle zugehörigen Daten dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your account and its data. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tu cuenta y sus datos de forma permanente. No se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa tilisi ja sen tiedot pysyvästi. Toimintoa ei voi peruuttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement votre compte et ses données. Elle est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione elimina definitivamente il tuo account e i suoi dati. Non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとそのデータが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 데이터가 영구적으로 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter kontoen din og dataene dine permanent. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden je account en gegevens definitief verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trwale usunie Twoje konto i jego dane. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente sua conta e seus dados. Essa ação não pode ser desfeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina permanentemente a sua conta e os seus dados. Esta ação não pode ser anulada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт и все связанные с ним данные будут удалены безвозвратно. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta raderar ditt konto och dess data permanent. Det kan inte ångras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem hesabınızı ve verilerini kalıcı olarak siler. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис і всі дані буде видалено назавжди. Цю дію неможливо скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa vĩnh viễn tài khoản và dữ liệu của bạn. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将永久删除你的账户及其数据，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作將永久刪除你的帳號及其資料，且無法復原。"
          }
        }
      }
    },
