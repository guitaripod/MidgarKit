    "This permanently deletes your account and its data. This cannot be undone.": {
      "comment": "Message of the confirmation before deleting the account",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف حسابك وبياناته نهائيًا. لا يمكن التراجع عن ذلك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto trvale smažete svůj účet a jeho data. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter din konto og dens data permanent. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden dein Konto und alle zugehörigen Daten dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your account and its data. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tu cuenta y sus datos de forma permanente. No se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa tilisi ja sen tiedot pysyvästi. Toimintoa ei voi peruuttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement votre compte et ses données. Elle est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione elimina definitivamente il tuo account e i suoi dati. Non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとそのデータが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 데이터가 영구적으로 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter kontoen din og dataene dine permanent. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden je account en gegevens definitief verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trwale usunie Twoje konto i jego dane. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente sua conta e seus dados. Essa ação não pode ser desfeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina permanentemente a sua conta e os seus dados. Esta ação não pode ser anulada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт и все связанные с ним данные будут удалены безвозвратно. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta raderar ditt konto och dess data permanent. Det kan inte ångras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem hesabınızı ve verilerini kalıcı olarak siler. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис і всі дані буде видалено назавжди. Цю дію неможливо скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa vĩnh viễn tài khoản và dữ liệu của bạn. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将永久删除你的账户及其数据，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作將永久刪除你的帳號及其資料，且無法復原。"
          }
        }
      }
    },
    "Turning this off stops the app from sending counts and deletes any that are waiting.": {
      "comment": "Footer under the on/off switch for anonymous usage counts.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إيقاف هذا الخيار يتوقف التطبيق عن إرسال العدادات، ويحذف أي عدادات في انتظار الإرسال."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnutím přestane aplikace odesílat počty a smaže všechny, které čekají na odeslání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du slår dette fra, stopper appen med at sende tal, og de tal, der venter, slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das ausschaltest, sendet die App keine Zählwerte mehr und löscht alle, die noch auf den Versand warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning this off stops the app from sending counts and deletes any that are waiting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desactivarlo, la app deja de enviar recuentos y borra los que estén pendientes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tämän kytkee pois, sovellus lopettaa lukujen lähettämisen ja poistaa odottavat luvut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous désactivez cette option, l'app cesse d'envoyer des compteurs et supprime ceux qui attendent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivando questa opzione, l'app smette di inviare i conteggi ed elimina quelli in attesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定をオフにすると、アプリは利用回数の送信を停止し、送信待ちの回数を削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정을 끄면 앱이 사용 횟수를 보내지 않으며, 보내기를 기다리는 횟수도 삭제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du slår av dette, slutter appen å sende tall, og tall som venter blir slettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je dit uitzet, stopt de app met het verzenden van tellingen en worden de tellingen die wachten verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączenie tej opcji zatrzymuje wysyłanie liczników przez aplikację i usuwa te, które czekają na wysłanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar isso impede que o app envie contagens e apaga as que estiverem aguardando envio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar isto impede a aplicação de enviar contagens e apaga as que estiverem à espera de envio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключить это, приложение перестанет отправлять статистику и удалит всю статистику, которая ожидает отправки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du stänger av detta slutar appen att skicka statistik och tar bort all statistik som väntar på att skickas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kapatmak, uygulamanın sayıları göndermesini durdurur ve gönderilmeyi bekleyen tüm sayıları siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вимкнути це, застосунок припинить надсилати лічильники та видалить ті, що очікують на надсилання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, ứng dụng sẽ ngừng gửi số lần sử dụng và xóa những số đang chờ gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，应用将停止发送使用次数，并删除所有等待发送的次数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，App 將停止傳送使用次數，並刪除所有等待傳送的次數。"
          }
        }
      }
    },
