          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити посилання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở liên kết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟連結。"
          }
        }
      }
    },
    "The screen with other Midgar apps was opened, and from where in the app.": {
      "comment": "Purpose of an anonymous count. Midgar is a company name, do not translate it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فتح الشاشة التي تعرض تطبيقات Midgar الأخرى، ومن أين في التطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovka s dalšími aplikacemi Midgar byla otevřena a odkud v aplikaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmen med andre Midgar-apps blev åbnet, og hvorfra i appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm mit anderen Midgar-Apps wurde geöffnet, und von wo in der App aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen with other Midgar apps was opened, and from where in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abrió la pantalla con otras apps de Midgar y desde dónde en la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkymä, jossa on muita Midgar-sovelluksia, avattiin, ja mistä kohtaa sovellusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran des autres apps Midgar a été ouvert, et d'où dans l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stata aperta la schermata con le altre app Midgar, e da dove nell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のMidgarアプリの一覧画面が開かれた回数と、アプリ内のどこから開かれたか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Midgar 앱이 있는 화면이 열렸으며, 앱 내 어디에서 열렸는지."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermen med andre Midgar-apper ble åpnet, og hvor i appen den ble åpnet fra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het scherm met andere Midgar-apps is geopend, en vanaf welk punt in de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarto ekran z innymi aplikacjami Midgar, i skąd w aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela com outros apps da Midgar foi aberta, e de onde no app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã com outras aplicações Midgar foi aberto, e a partir de onde na aplicação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыт экран других приложений Midgar и место в приложении, откуда его открыли."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmen med andra Midgar-appar öppnades, och varifrån i appen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer Midgar uygulamalarının ekranının açıldığı ve uygulamanın hangi bölümünden açıldığı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрито екран з іншими застосунками Midgar, і звідки в застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã mở màn hình có các ứng dụng Midgar khác, và từ vị trí nào trong ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开了包含其他 Midgar 应用的页面，以及在应用中的打开位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟了包含其他 Midgar App 的畫面，以及在 App 中的開啟位置。"
          }
        }
      }
    },
