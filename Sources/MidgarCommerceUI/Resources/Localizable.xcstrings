        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험이 곧 끝난다는 알림을 보내 드립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnimy Ci, że bezpłatny okres próbny się kończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisaremos que o seu teste está terminando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会提醒你试用即将结束。"
          }
