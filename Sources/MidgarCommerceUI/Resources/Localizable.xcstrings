    "The App Store could not verify this purchase, so it was not applied. Please try again.": {
      "comment": "Alert message when the signature of a purchase could not be verified",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store could not verify this purchase, so it was not applied. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store konnte diesen Kauf nicht überprüfen, daher wurde er nicht angewendet. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La App Store no pudo verificar esta compra, así que no se ha aplicado. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store n'a pas pu vérifier cet achat, il n'a donc pas été appliqué. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store non è riuscito a verificare questo acquisto, quindi non è stato applicato. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeでこの購入を確認できなかったため、適用されませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 이 구입 항목을 확인하지 못해 적용되지 않았습니다. 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nie mógł zweryfikować tego zakupu, więc nie został zastosowany. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não conseguiu verificar esta compra, então ela não foi aplicada. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 无法验证此次购买，因此未生效。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 無法驗證此次購買，因此未生效。請再試一次。"
          }
        }
      }
    },
    "The App Store did not return any plans. Check your connection and try again.": {
      "comment": "Detail shown on the paywall when the App Store returned no plans",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store did not return any plans. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store hat keine Pläne zurückgegeben. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La App Store no devolvió ningún plan. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
