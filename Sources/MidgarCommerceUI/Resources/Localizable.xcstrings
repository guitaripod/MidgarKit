    "Your credits arrive as soon as it is confirmed. You do not need to buy again.": {
      "comment": "Detail of the row shown after a credit pack was paid for but its credits have not arrived yet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your credits arrive as soon as it is confirmed. You do not need to buy again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Credits kommen an, sobald der Kauf bestätigt ist. Du musst nicht erneut kaufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus créditos llegarán en cuanto se confirme. No necesitas volver a comprar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos crédits arriveront dès la confirmation. Vous n'avez pas besoin de racheter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
