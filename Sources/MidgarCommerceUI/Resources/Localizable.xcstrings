        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. Tendrás acceso en cuanto se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d'approbation. Vous aurez accès dès qu'elle sera approuvée."
