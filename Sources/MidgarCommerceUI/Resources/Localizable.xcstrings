    "The App Store did not return any credit packs. Check your connection and try again.": {
      "comment": "Detail shown in the credit store when the App Store returned no credit packs",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store did not return any credit packs. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store hat keine Credit-Pakete zurückgegeben. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
