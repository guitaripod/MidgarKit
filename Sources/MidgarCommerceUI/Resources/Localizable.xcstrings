            "state": "translated",
            "value": "Warten auf Genehmigung. Du erhältst Zugriff, sobald sie erteilt wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. Tendrás acceso en cuanto se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d'approbation. Vous aurez accès dès qu'elle sera approuvée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di approvazione. Avrai accesso non appena verrà approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ちです。承認されるとすぐに利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 대기 중입니다. 승인되는 즉시 이용할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na zatwierdzenie. Dostęp otrzymasz od razu po zatwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação. Você terá acesso assim que for aprovada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待批准。获批后即可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待核准。核准後即可使用。"
          }
        }
      }
    },
    "We'll remind you that your trial is ending.": {
      "comment": "Free trial timeline: the step on which the app sends a reminder",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll remind you that your trial is ending."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir erinnern dich, dass deine Testphase endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisaremos de que tu prueba está a punto de terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous rappellerons que votre essai touche à sa fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti ricorderemo che la prova sta per finire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルが終了することをお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험이 곧 끝난다는 알림을 보내 드립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnimy Ci, że bezpłatny okres próbny się kończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisaremos que o seu teste está terminando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会提醒你试用即将结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會提醒你試用即將結束。"
          }
        }
      }
    },
    "Your plan continues at %@. Cancel before this day and you won't be charged.": {
      "comment": "Free trial timeline: the day billing starts; the placeholder is the price with its period, e.g. $39.99/year",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan continues at %@. Cancel before this day and you won't be charged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Plan läuft weiter für %@. Kündige vor diesem Tag, und es fällt keine Gebühr an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan continúa a %@. Cancela antes de este día y no se te cobrará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement continue à %@. Annulez avant ce jour et vous ne serez pas facturé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo piano continua a %@. Annulla prima di questo giorno e non ti verrà addebitato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で継続します。この日より前に解約すれば、請求されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 플랜이 계속 이어집니다. 이 날 전에 해지하면 요금이 청구되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój plan będzie kontynuowany za %@. Anuluj przed tym dniem, a nie zostaniesz obciążony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu plano continua por %@. Cancele antes deste dia e você não será cobrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的方案将以 %@ 继续。在此日之前取消则不会扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的方案將以 %@ 繼續。在此日之前取消即不會扣款。"
          }
        }
      }
    },
