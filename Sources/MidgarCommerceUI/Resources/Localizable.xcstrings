        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 플랜을 가져오지 못했습니다. 연결 상태를 확인하고 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
