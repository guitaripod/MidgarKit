    },
    "The purchase could not be verified. If you were charged, contact support.": {
      "comment": "Message when the credit service refused to credit a pack the person paid for",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase could not be verified. If you were charged, contact support."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht überprüft werden. Falls dir etwas berechnet wurde, wende dich an den Support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la compra. Si se te cobró, contacta con soporte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat n'a pas pu être vérifié. Si vous avez été débité, contactez l'assistance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
