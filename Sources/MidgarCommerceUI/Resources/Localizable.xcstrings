        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會提醒你試用即將結束。"
          }
        }
      }
    },
    "Your plan continues at %@. Cancel before this day and you won't be charged.": {
      "comment": "Free trial timeline: the day billing starts; the placeholder is the price with its period, e.g. $39.99/year",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan continues at %@. Cancel before this day and you won't be charged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Plan läuft weiter für %@. Kündige vor diesem Tag, und es fällt keine Gebühr an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan continúa a %@. Cancela antes de este día y no se te cobrará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement continue à %@. Annulez avant ce jour et vous ne serez pas facturé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo piano continua a %@. Annulla prima di questo giorno e non ti verrà addebitato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で継続します。この日より前に解約すれば、請求されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 플랜이 계속 이어집니다. 이 날 전에 해지하면 요금이 청구되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój plan będzie kontynuowany za %@. Anuluj przed tym dniem, a nie zostaniesz obciążony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu plano continua por %@. Cancele antes deste dia e você não será cobrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
